{
  "name": "design",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --mode development",
    "dev:test": "vite --mode test",
    "dev:prod": "vite --mode production",
    "build": "vue-tsc -b && vite build",
    "build:dev": "vue-tsc -b && vite build --mode development",
    "build:test": "vue-tsc -b && vite build --mode test",
    "build:prod": "vue-tsc -b && vite build --mode production && cp deploy/nginx-media-proxy.conf deploy/nginx-media-proxy-http.conf deploy/nginx-daone-web.conf deploy/nginx-site.conf dist/ && node scripts/check-api-base.mjs && node scripts/check-bundle-budget.mjs",
    "preview": "vite preview",
    "start": "node server.mjs",
    "typecheck": "vue-tsc -b --pretty false",
    "typecheck:strict": "vue-tsc -p tsconfig.daone-strict.json --noEmit --pretty false",
    "lint:eslint": "eslint --max-warnings=0 \"src/utils/request.ts\" \"src/utils/leaveGuard.ts\" \"src/hooks/sseParser.ts\" \"src/components/Canvas/lib/**/*.{ts,tsx}\" \"src/components/Canvas/mediaProxy.ts\" \"src/components/Canvas/mediaProxyAllowlist.ts\" \"src/components/Canvas/groupExecute/**/*.{ts,tsx}\" \"src/components/Canvas/generationTaskState.ts\" \"src/components/Canvas/generationTaskApply.ts\" \"src/components/Canvas/graphNodeSizing.ts\" \"src/components/Canvas/graphCoords.ts\"",
    "lint:prettier:check": "prettier --check \"src/utils/request.ts\" \"src/utils/leaveGuard.ts\" \"src/hooks/sseParser.ts\" \"src/components/Canvas/lib/**/*.{ts,tsx}\" \"src/components/Canvas/mediaProxy.ts\" \"src/components/Canvas/mediaProxyAllowlist.ts\" \"src/components/Canvas/groupExecute/**/*.{ts,tsx}\" \"src/components/Canvas/generationTaskState.ts\" \"src/components/Canvas/generationTaskApply.ts\" \"src/components/Canvas/graphNodeSizing.ts\" \"src/components/Canvas/graphCoords.ts\"",
    "lint:stylelint:check": "stylelint --cache \"src/components/Canvas/**/*.{vue,css,scss}\" --cache-location node_modules/.cache/stylelint/",
    "lint:check": "npm run typecheck:strict && node scripts/quality-gate.mjs && npm run lint:eslint && npm run lint:prettier:check && npm run lint:stylelint:check",
    "test": "NODE_ENV=test MEDIA_PROXY_ALLOW_EPHEMERAL_SECRET=1 node --experimental-strip-types --test --test-force-exit scripts/media-proxy.test.mjs scripts/server-malformed-url.test.mjs scripts/chat-race-regressions.test.ts scripts/sse-parser.test.ts scripts/prompt-mention-insert.test.ts scripts/canvas-split-regressions.test.ts scripts/canvas-group-execute-regressions.test.ts scripts/canvas-shell-panels-race.test.ts scripts/canvas-autosave-ready.test.ts scripts/canvas-manual-save-gate.test.ts scripts/canvas-load-race.test.ts scripts/canvas-save-leave-gate.test.ts scripts/video-node-dblclick-size.test.ts scripts/trial-sms-contract.test.ts scripts/ai-point-estimate.test.ts",
    "test:media-proxy": "NODE_ENV=test MEDIA_PROXY_ALLOW_EPHEMERAL_SECRET=1 node --test --test-force-exit scripts/media-proxy.test.mjs",
    "check:bundle-budget": "node scripts/check-bundle-budget.mjs"
  },
  "dependencies": {
    "@ant-design/icons-vue": "^7.0.1",
    "@antv/x6": "^2.19.2",
    "@antv/x6-plugin-minimap": "^2.0.7",
    "@antv/x6-plugin-scroller": "^2.0.10",
    "@antv/x6-plugin-selection": "^2.2.2",
    "@antv/x6-plugin-transform": "^2.1.8",
    "ant-design-vue": "4.x",
    "axios": "^1.18.0",
    "dayjs": "^1.11.21",
    "dompurify": "^3.4.13",
    "jszip": "^3.10.1",
    "marked": "^18.0.9",
    "pdfjs-dist": "^6.0.227",
    "pinia": "^3.0.4",
    "qrcode": "^1.5.4",
    "sass": "^1.100.0",
    "three": "^0.185.1",
    "uuid": "^14.0.1",
    "vue": "^3.5.34",
    "vue-router": "^5.1.0",
    "vue3-slide-verify": "^1.1.8",
    "x6-html-shape": "^0.4.9"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@types/node": "^24.12.3",
    "@types/qrcode": "^1.5.6",
    "@types/three": "^0.185.1",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^9.36.0",
    "eslint-plugin-vue": "^10.4.0",
    "postcss-html": "^1.8.0",
    "postcss-scss": "^4.0.9",
    "prettier": "^3.6.2",
    "stylelint": "^16.23.1",
    "stylelint-config-recommended-vue": "^1.6.1",
    "stylelint-config-standard": "^39.0.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.44.0",
    "unplugin-auto-import": "^21.0.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.0.12",
    "vue-tsc": "^3.2.8"
  }
}
