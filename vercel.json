{
  "rewrites": [
    {
      "source": "/api/v1/:path*",
      "destination": "https://api.daoneai.com/api/v1/:path*"
    },
    {
      "source": "/media-proxy/:host/:path*",
      "destination": "/api/media-proxy/:host/:path*"
    },
    {
      "source": "/media-proxy",
      "destination": "/api/media-proxy"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
