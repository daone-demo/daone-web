# 生产环境

# 当前环境标识
VITE_APP_ENV = 'production'

# 生产浏览器直连后端绝对地址（构建期写入产物，不依赖站点 Nginx/Vercel 的 /api 反代）
VITE_API_BASE_URL = 'https://43.161.199.75/api/api/v1'

# 上游 origin（文档/检查用；生产包不依赖此变量做请求）
VITE_API_BASE_HOST = 'https://43.161.199.75'

# 可选：media-proxy HMAC（须与进程环境 MEDIA_PROXY_HMAC_SECRET 一致；不配则用内置默认密钥）
# VITE_MEDIA_PROXY_HMAC_SECRET=
# 可选：追加精确桶域名
# VITE_MEDIA_PROXY_ALLOWED_HOSTS=
