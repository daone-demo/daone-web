# 生产环境

# 当前环境标识
VITE_APP_ENV = 'production'

# 生产走同源相对前缀，由 Vercel rewrites / Nginx 反代到后端（符合 CSP connect-src 'self' https:）
VITE_API_BASE_URL = '/api/api/v1'

# 上游 origin（文档/检查用；生产包不依赖此变量做请求）
VITE_API_BASE_HOST = 'http://43.161.199.75'

# media-proxy：HMAC 仅服务端环境变量（禁止 VITE_ 前缀）
# MEDIA_PROXY_HMAC_SECRET=
# MEDIA_PROXY_AUTH_API_BASE=https://43.161.199.75/api/api/v1
# MEDIA_PROXY_TRUST_PROXY=1
# MEDIA_PROXY_ALLOWED_HOSTS=
# 可选公开桶名（非密钥）：
# VITE_MEDIA_PROXY_ALLOWED_HOSTS=
