# 开发环境

# 当前环境标识
VITE_APP_ENV = 'development'

# 开发走 Vite 同源代理（vite.config.ts 的 /api → VITE_API_BASE_HOST），避免直连跨域/证书问题
VITE_API_BASE_URL = '/api/api/v1'

# 仅作开发代理上游 origin（不要带 /api 路径）
VITE_API_BASE_HOST = 'https://43.161.199.75:8088'

# 若测试后端开启 Vercel Deployment Protection，在 .env.development.local 配置：
# VITE_VERCEL_PROTECTION_BYPASS=你的密钥

# 可选：覆盖 media-proxy HMAC（需与服务端 MEDIA_PROXY_HMAC_SECRET 一致）
# VITE_MEDIA_PROXY_HMAC_SECRET=your-shared-secret
# 可选：追加精确桶域名（逗号分隔）
# VITE_MEDIA_PROXY_ALLOWED_HOSTS=my-bucket.oss-cn-hangzhou.aliyuncs.com
